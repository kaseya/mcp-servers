{
  // Type-checks the JavaScript and its JSDoc annotations. Nothing is emitted: scripts/build.mjs bundles
  // the relay with esbuild.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src", "scripts", "test", "eslint.config.js"]
}
