{
  "name": "autotask-mcp-desktop-extension",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "The Autotask Claude Desktop extension: a relay from Claude Desktop's stdio to the hosted Autotask MCP Regional endpoint.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "version:check": "node scripts/checkVersion.mjs",
    "validate": "mcpb validate manifest.json",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node test/conformance.mjs",
    "check": "npm run lint && npm run format && npm run typecheck && npm run version:check && npm run validate && npm test",
    "pack": "npm run check && mcpb pack . autotask-mcp.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "zod": "4.2.1"
  }
}
